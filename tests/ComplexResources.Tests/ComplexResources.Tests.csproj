<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ComplexResources.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- To drive the generator directly (no source-generator testing helpers needed). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core types + attributes. -->
    <ProjectReference Include="..\..\ComplexResources\ComplexResources.csproj" />
    <!-- The generator is referenced as a plain library here (NOT an analyzer) so tests can
         instantiate it and run it against hand-built compilations. -->
    <ProjectReference Include="..\..\gen\ComplexResources.Generator.csproj" />
  </ItemGroup>

</Project>
