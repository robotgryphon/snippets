<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.0" />
    <PackageReference Include="HotChocolate.Fusion.Aspire" Version="16.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The integration itself. IsAspireProjectResource="false" is required: the AppHost SDK defaults
      every ProjectReference to true, which generates a Projects.* class and sets
      ReferenceOutputAssembly=false / ExcludeAssets=all, so the assembly is never referenced as code.
      This is a library, not a resource, so it opts out and is referenced normally.
    -->
    <ProjectReference Include="../../../src/ExternalGraphQL/ExternalGraphQL.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="../ExternalGraphQLDemo.Gateway/ExternalGraphQLDemo.Gateway.csproj" />
  </ItemGroup>

</Project>
