<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Resources</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Inspect generated sources under obj/generated for debugging. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- The generator lives in this repo but is a netstandard2.0 analyzer; keep its sources
       out of this net10 compilation, and reference its output as an analyzer. -->
  <ItemGroup>
    <ProjectReference Include="..\ComplexResources\ComplexResources.csproj" />
    <ProjectReference Include="..\gen\ComplexResources.Generator.csproj" 
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
